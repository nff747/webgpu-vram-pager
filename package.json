{
  "name": "webgpu-vram-pager",
  "version": "0.1.0",
  "description": "Dynamic memory management and PCIe streaming wrapper for WebGPU to bypass maxStorageBufferBindingSize limits and run 8B parameter LLMs in browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nff747/webgpu-vram-pager.git"
  },
  "keywords": [
    "webgpu",
    "llm",
    "webllm",
    "memory-management",
    "vram",
    "pcie",
    "browser-ai"
  ],
  "author": "iKi <nff747@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
